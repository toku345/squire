opam-version: "2.0"
name: "squire"
version: "dev"
synopsis: "A personal work companion for Herdr"
maintainer: "toku345"
authors: "toku345"
depends: [
  "astring" {= "0.8.5"}
  "base" {= "v0.17.3"}
  "base-bigarray" {= "base"}
  "base-bytes" {= "base"}
  "base-domains" {= "base"}
  "base-effects" {= "base"}
  "base-nnp" {= "base"}
  "base-threads" {= "base"}
  "base-unix" {= "base"}
  "camlp-streams" {= "5.0.1"}
  "cmdliner" {= "2.1.1"}
  "conf-pkg-config" {= "5"}
  "conf-sqlite3" {= "1"}
  "cppo" {= "1.8.0"}
  "csexp" {= "1.5.2"}
  "cstruct" {= "6.3.0"}
  "dune" {= "3.24.2"}
  "dune-build-info" {= "3.24.2"}
  "dune-compiledb" {= "0.6.0"}
  "dune-configurator" {= "3.24.2"}
  "either" {= "1.0.0"}
  "ezjsonm" {= "1.3.0"}
  "fix" {= "20250919"}
  "fmt" {= "0.11.0"}
  "fpath" {= "0.7.3"}
  "hex" {= "1.5.0"}
  "jsonm" {= "1.0.2"}
  "lwt" {= "6.1.2"}
  "menhir" {= "20260209"}
  "menhirCST" {= "20260209"}
  "menhirGLR" {= "20260209"}
  "menhirLib" {= "20260209"}
  "menhirSdk" {= "20260209"}
  "num" {= "1.6"}
  "ocaml" {= "5.4.1"}
  "ocaml-config" {= "3"}
  "ocaml-system" {= "5.4.1"}
  "ocaml-version" {= "4.1.4"}
  "ocaml_intrinsics_kernel" {= "v0.17.2"}
  "ocamlbuild" {= "0.16.1"}
  "ocamlfind" {= "1.9.8"}
  "ocamlformat" {= "0.29.0"}
  "ocamlformat-lib" {= "0.29.0"}
  "ocp-indent" {= "1.10.0"}
  "ocplib-endian" {= "1.2"}
  "parsexp" {= "v0.17.0"}
  "re" {= "1.14.0"}
  "sexplib" {= "v0.17.0"}
  "sexplib0" {= "v0.17.0"}
  "sqlite3" {= "5.4.2"}
  "stdio" {= "v0.17.0"}
  "topkg" {= "1.1.1"}
  "uucp" {= "18.0.0"}
  "uuseg" {= "18.0.0"}
  "uutf" {= "1.0.4"}
  "yojson" {= "3.0.0"}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]