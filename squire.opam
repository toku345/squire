authors: ["toku345"]
depends: [
  "ocaml" {= "5.4.1"}
  "dune" {>= "3.24" & = "3.24.2"}
  "cmdliner" {>= "2.1.1"}
  "yojson" {>= "3.0.0"}
  "lwt" {>= "6.1.2"}
  "sqlite3" {>= "5.4.2"}
